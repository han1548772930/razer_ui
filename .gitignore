# Build outputs and disposable scratch
/target/
/cargo-check-target/
/assets/synapse.pack
**/target/
/.work/
*.log
*.work
# Resource payloads are distributed separately through Hugging Face.
# Keep the standalone catalog and native tray/menu icons in product resources.
/assets/**
!/assets/synapse/
!/assets/synapse/resource-catalog.sqlite3
!/assets/synapse/shared/
!/assets/synapse/shared/pending-source-audit/
!/assets/synapse/shared/pending-source-audit/a64b8a64b721fb74-tray-native.rgba
!/assets/synapse/shared/pending-source-audit/f979021796dfd342-tray-app.rgba
!/assets/synapse/shared/pending-source-audit/81851a9004a803d3-tray-icon-24.rgba
!/assets/synapse/shared/pending-source-audit/71b354f660adb5db-tray-icon.rgba
!/assets/synapse/shared/pending-source-audit/f8fd980e3bec82fe-tray-icon-40.rgba
!/assets/synapse/shared/pending-source-audit/5e5df98271550aca-tray-icon-48.rgba
!/assets/synapse/shared/pending-source-audit/afb1350c23ce2416-tray-icon-64.rgba
!/assets/synapse/shared/pending-source-audit/7747f51f284ded65-tray-gear-dark.rgba
!/assets/synapse/shared/pending-source-audit/33892a0b56b91958-tray-gear-light.rgba

# Original analysis inputs and generated captures are local data.
/.ref/
/local-ui-reverse
/.analysis/*
!/.analysis/README.md
/.analysis/inputs.json
!/.analysis/validation.json

# Tool dependencies and caches; maintained tools/configuration remain tracked.
**/node_modules/
**/__pycache__/
*.py[cod]
/tools/analyzers/**/wakaru.exe
/tools/analyzers/python-3.11.9/*
!/tools/analyzers/python-3.11.9/acquisition.json
/tools/analyzers/ilspycmd-9.1.0.7988/*
!/tools/analyzers/ilspycmd-9.1.0.7988/acquisition.json
/tools/analyzers/innounp-2.71.1/*
!/tools/analyzers/innounp-2.71.1/acquisition.json
/tools/analyzers/python-static/*
!/tools/analyzers/python-static/acquisition.json
/tools/ida/analysis-current/
/tools/ida/idausr/*.cfg
/tools/ida/idausr/proccache64.lst
/tools/ida/idausr/proccache.lst
/tools/ida/idausr/plugins/ida_mcp.py
/tools/ida/idausr/plugins/ida_mcp/

# IDA working databases
*.i64
*.idb
*.id0
*.id1
*.id2

# Editor and operating-system scratch
.DS_Store
Thumbs.db
*.tmp
