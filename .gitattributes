# Preserve resource bytes used by acquisition and embedding manifests.
assets/**/*.svg -text
assets/**/*.png -text
assets/**/*.avif -text
assets/**/*.jpg -text
assets/**/*.jpeg -text
assets/**/*.gif -text
assets/**/*.webp -text
assets/**/*.ico -text
assets/**/*.woff -text
assets/**/*.woff2 -text
assets/**/*.ttf -text
assets/**/*.otf -text
assets/synapse/resource-catalog.sqlite3 -filter -diff -merge -text
tools/analyzers/ccl-chromium-reader/** -text
tools/analyzers/python-static/tree_sitter*/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
tools/analyzers/pillow/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Source/test JSON continues to use LFS, regardless of file size.
# The basename pattern also covers JSON in crates, testdata, tools and .analysis.
# Resource payloads are ignored here and use the HF dataset's own LFS rules.
*.json filter=lfs diff=lfs merge=lfs -text

# The resource lock is reviewable source metadata, including its immutable HF commit.
tools/asset-release.json -filter diff merge text eol=lf

# Generated Rust lookup tables remain ordinary source code.
assets/**/*.rs -filter diff merge text=auto

# Native tray and menu icons required by the platform integration stay in Git.
# These exact paths are embedded by crates/razer-tray/src/{lib,windows}.rs.
# Other UI icons, including tray-user artwork, are external resource payloads.
# Add any future installer icon only after a packaging caller requires it.
