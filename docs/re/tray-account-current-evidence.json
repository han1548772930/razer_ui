  "rules": [
    ".systray .app-section-title>.btn-text{font-size:10px;position:absolute;right:20px;text-decoration:underline;text-transform:uppercase}",
    ".systray .app-section-title>.btn-text:not(:hover){color:#ccc}",
    ".systray>.header,.systray>.header-2{align-items:center;background-color:#000;display:flex;height:60px;padding:0 20px;position:relative}",
    ".systray>.header:before{background-color:#000;content:\"\";height:100%;left:0;opacity:0;pointer-events:none;position:absolute;top:0;transition:opacity .1s linear;width:100%}",
    ".systray>.header:active:before{opacity:.1}",
    ".systray>.header>.avatar{background-image:url(../../static/media/user.53ceca5f.svg);background-repeat:no-repeat;background-size:100%;border-radius:50%;flex-shrink:0;height:40px;margin-right:10px;width:40px}",
    ".systray>.header>.avatar.guest{background-image:url(../../static/media/guest.99887b67.svg)}",
    ".systray>.header>.info{margin-right:10px;min-width:0}",
    ".systray>.header>.info>.username{color:#fff;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}",
    ".systray>.header>.btn-view-online{margin-left:auto;opacity:0;padding-left:7px;padding-right:7px;transition:opacity .1s ease-out}",
    ".systray>.header:hover>.btn-view-online{opacity:1}",
    ".systray>.header-2{background-color:#222;justify-content:center;padding-bottom:1px;transition:background-color .1s ease-in-out,color .1s ease-in-out}",
    ".systray>.header-2:hover{background-color:#000;color:#eee}",
    ".btn{backface-visibility:hidden;background-color:initial;border:1px solid #0000004d;border-radius:2px;color:#fff;cursor:default;display:inline-block;font-size:12px;line-height:1;min-width:90px;outline:none;padding:7px 16px 6px;text-align:center;text-decoration:none;text-transform:uppercase;transition:opacity .2s ease-out,background-color .2s ease-out;-webkit-user-select:none;user-select:none}",
    ".btn:hover{opacity:.8}",
    ".btn:active{opacity:.6}",
    ".btn.disabled{opacity:.3}",
    ".btn.disabled,.btn[readonly]{pointer-events:none}",
    ".btn.btn-outline-white{border-color:#ccc;color:#ccc}",
    ".btn.btn-outline-white:hover{background-color:#000;opacity:1}",
    ".btn.btn-outline-white:active{background-color:initial;opacity:1}",
    ".btn.btn-outline-black{border-color:#212121;color:#212121}",
    ".navbar{border-top:1px solid #111;display:flex;position:relative}",
    ".navbar:after{background-color:#111;content:\"\";height:2px;position:absolute;top:100%;width:100%}",
    ".navbar>.tabs{display:flex}",
    ".navbar>.btn-settings,.navbar>.tabs>li{color:#999;font-size:12px;text-transform:uppercase;transition:background-color .1s ease-in-out,color .1s ease-in-out}",
    ".navbar>.tabs>li{padding:9px 20px 8px;vertical-align:middle}",
    ".navbar>.tabs>li.active{color:#fff}",
    ".navbar>.btn-settings:hover,.navbar>.tabs>li:hover{background-color:#111}",
    ".navbar>.btn-settings{align-items:center;display:flex;margin-left:auto;padding:0 23px;position:relative}",
    ".navbar>.btn-settings path{fill:#999;transition:fill .1s ease-in-out}",
    ".navbar>.btn-settings:hover path{fill:#fff}",
    ".navbar>.tabs>li>.badge{align-items:center;border-radius:50%;color:#111;display:inline-block;font-size:12px;justify-content:center;line-height:1;margin-left:5px;padding:0 6px;position:relative;text-align:center;z-index:1}",
    ".navbar>.tabs>li>.badge:before{background-color:#44d62c;border-radius:19px;content:\"\";height:19px;left:0;position:absolute;top:-4px;width:100%;z-index:-1}",
    ".notifications-spinner.spinner-razer{bottom:0;height:31px;left:0;margin:auto;position:absolute;right:0;top:0;width:31px}",
    ".notifications>li{background-color:#111;cursor:pointer;margin-bottom:10px}",
    ".notifications>li:last-child{margin-bottom:0}",
    ".notifications>li>.img{background-position:50%;background-repeat:no-repeat;background-size:cover;height:102px;width:100%}",
    ".notifications>li>.info{padding:20px}",
    ".notifications>li>.info>.title{line-height:1;margin-bottom:5px;overflow:hidden;text-overflow:ellipsis;text-transform:uppercase;white-space:nowrap}",
    ".notifications>li>.info>.desc{-webkit-box-orient:vertical;-webkit-line-clamp:2;color:#999;display:-webkit-box;font-size:14px;height:34px;margin-bottom:4px;overflow:hidden}",
    ".notifications>li>.info>.helper{color:#999;display:flex;font-size:12px}",
    ".notifications>li>.info>.helper>.date{flex-shrink:0;margin-right:10px}",
    ".notifications>li>.info>.helper>.desc{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}",
    ".notifications-default{padding:20px;text-align:center}",
    ".notifications-default>.btn-text,.notifications-default>.desc{font-size:14px}",
    ".notifications-default>.desc{margin-bottom:10px}",
    ".notifications-default>.btn-text{text-decoration:underline}",
    ".btn-text{color:#ccc;cursor:default;font-size:14px;transition:color .1s ease-in-out,opacity .1s linear}",
    ".btn-text:hover{color:#44d62c}",
    ".btn-text:active{opacity:.7}",
    ".btn-text.disabled{opacity:.3;pointer-events:none}",
    ".spinner-razer{display:inline-block;height:27px;width:27px}",
    ".spinner-razer>svg{height:100%;width:100%}"
  ],
